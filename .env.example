# Copie ce fichier en .env.local (ignoré par git) et remplis-le depuis Supabase → Project Settings → API Keys.
# Sur Vercel : Project Settings → Environment Variables, mêmes noms (sauf la clé secrète, inutile à l'app).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publishable (sb_publishable_…) : l'app agit avec la session de l'utilisateur connecté.
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) : seulement pour les scripts (migrate:supabase, link-player). Jamais sur Vercel.
SUPABASE_SECRET_KEY=
